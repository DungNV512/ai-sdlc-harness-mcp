# Atlassian Cloud API token auth (email + API token -> HTTP Basic).
# Shared by both Confluence and Jira clients (one Atlassian identity).
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# Base URL of the Confluence Cloud site, no trailing slash.
CONFLUENCE_SITE=https://your-site.atlassian.net

# Base URL of the Jira Cloud site, no trailing slash. Usually the same host
# as CONFLUENCE_SITE (Jira and Confluence Cloud share a site on one domain).
JIRA_SITE=https://your-site.atlassian.net
