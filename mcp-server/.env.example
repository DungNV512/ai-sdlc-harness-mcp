# Confluence & Jira (Atlassian)
CONFLUENCE_SITE=https://ipas-tech.atlassian.net
ATLASSIAN_EMAIL=your-email@example.com
ATLASSIAN_API_TOKEN=your-api-token-here
JIRA_SITE=https://ipas-tech.atlassian.net

# GitHub
GITHUB_TOKEN=your-github-token-here
GITHUB_API_URL=https://api.github.com

# GitLab (gitlab.com)
GITLAB_TOKEN=your-gitlab-token-here
GITLAB_API_URL=https://gitlab.com/api/v4

# GitLab (gitlab-new.vndirect.com.vn — Stockbook)
# GITLAB_TOKEN=your-gitlab-token-here
# GITLAB_API_URL=https://gitlab-new.vndirect.com.vn/api/v4

# Microsoft Teams
TEAMS_WEBHOOK_URL=https://hooks.microsoft.com/services/...
SMOKE_TEAMS_SEND=0

# Claude Code (binary must be on PATH; usually installed via `brew install claude`)
# No env var needed; smoke test checks for `claude` command availability
