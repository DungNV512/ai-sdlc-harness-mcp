# Atlassian Cloud API token auth (email + API token -> HTTP Basic).
# Shared by both Confluence and Jira clients (one Atlassian identity).
# Create a token at https://id.atlassian.com/manage-profile/security/api-tokens
ATLASSIAN_EMAIL=you@example.com
ATLASSIAN_API_TOKEN=

# Base URL of the Confluence Cloud site, no trailing slash.
CONFLUENCE_SITE=https://your-site.atlassian.net

# Base URL of the Jira Cloud site, no trailing slash. Usually the same host
# as CONFLUENCE_SITE (Jira and Confluence Cloud share a site on one domain).
JIRA_SITE=https://your-site.atlassian.net

# GitHub REST API v3 auth: Bearer-token PAT (fine-grained or classic, repo
# scope). Distinct from Atlassian's Basic auth above.
GITHUB_TOKEN=
# Optional: override for GitHub Enterprise. Defaults to https://api.github.com.
GITHUB_API_URL=https://api.github.com

# Microsoft Teams notifications (Phase 4). Get this URL from Teams itself:
#   channel or chat -> More options (...) -> Workflows -> pick a
#   webhook-alert template -> Save -> copy the generated URL.
# It is the CURRENT mechanism: Microsoft retired the classic Office 365
# Connector incoming webhook, and the Workflows app (Power Automate)
# replaced it. The URL will look like
#   https://<env>.environment.api.powerplatform.com/powerautomate/...&sig=...
#
# TREAT THIS AS A SECRET. The `sig` parameter is the whole authentication:
# anyone holding the URL can post into that chat. Never commit it -- this
# repo is public. send_teams_message redacts it from its own error messages
# for the same reason.
#
# Optional: when unset, /skill-submit simply does not notify. That is not an
# error. /notify-merge, whose only job is notifying, does refuse without it.
TEAMS_WEBHOOK_URL=
